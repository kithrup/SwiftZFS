SWIFT ?= swift
CC ?= cc
CXX ?= c++
DOXYGEN ?= doxygen
AR = @AR@
RANLIB = @RANLIB@
INSTALL = @INSTALL@
prefix = @prefix@
exec_prefix = @exec_prefix@
includedir = @includedir@
libdir = @libdir@
SWIFTZFS_CXXFLAGS = @ZFS_CPPFLAGS@
SWIFTZFS_LINKER_FLAGS = @SWIFT_LINKER_FLAGS@

SWIFT_ENV = SWIFTZFS_CXXFLAGS='$(SWIFTZFS_CXXFLAGS)' SWIFTZFS_LINKER_FLAGS='$(SWIFTZFS_LINKER_FLAGS)'

CPP_BUILD_DIR = .build-cpp
CPP_LIBRARY_SOURCES = \
	Sources/ZFSCPP/Context.cpp \
	Sources/ZFSCPP/Dataset.cpp \
	Sources/ZFSCPP/Error.cpp \
	Sources/ZFSCPP/Pool.cpp \
	Sources/ZFSCPP/PoolProperties.cpp \
	Sources/ZFSCPP/VDev.cpp \
	Sources/ZFSCPP/ZFSManager.cpp
CPP_LIBRARY_OBJS = $(patsubst Sources/ZFSCPP/%.cpp,$(CPP_BUILD_DIR)/%.o,$(CPP_LIBRARY_SOURCES))
CPP_LIBRARY = $(CPP_BUILD_DIR)/libswiftzfs_cpp.a
CPP_PUBLIC_HEADERS = $(wildcard Sources/ZFSCPP/include/*.hpp)
CPP_EXAMPLE_HEADERS = $(CPP_BUILD_DIR)/include/swiftzfs/.stamp
CPP_EXAMPLE_NAMES = list-pools list-datasets list-snapshots
CPP_EXAMPLE_BINS = $(addprefix $(CPP_BUILD_DIR)/examples/,$(CPP_EXAMPLE_NAMES))
CPP_LIST_POOLS = $(CPP_BUILD_DIR)/list-pools
C_SHIM_OBJ = $(CPP_BUILD_DIR)/CZFS.o
C_SHIM_TEST_OBJ = $(CPP_BUILD_DIR)/c-shim-test.o
C_SHIM_TEST = $(CPP_BUILD_DIR)/c-shim-test
CPPFLAGS_LOCAL = -ISources/ZFSCPP/include -ISources/ZFSCPP
C_SHIM_CPPFLAGS = -ISources/CZFS/include -ISources/ZFSCPP/include
CXXFLAGS_LOCAL = -std=c++17 -Wall -Wextra -Werror

.PHONY: all build debug release test run clean cpp-build cpp-test cpp-run cpp-install cpp-examples swift-examples c-shim-build c-shim-test c-shim-run docs

all: cpp-build c-shim-build

$(CPP_BUILD_DIR):
	mkdir -p $(CPP_BUILD_DIR)

$(CPP_BUILD_DIR)/%.o: Sources/ZFSCPP/%.cpp Sources/ZFSCPP/include/ZFS.hpp Sources/ZFSCPP/internal/ZFSInternal.hpp | $(CPP_BUILD_DIR)
	$(CXX) $(CXXFLAGS_LOCAL) $(SWIFTZFS_CXXFLAGS) $(CPPFLAGS_LOCAL) -c $< -o $@

$(CPP_LIBRARY): $(CPP_LIBRARY_OBJS)
	$(AR) rcs $@ $(CPP_LIBRARY_OBJS)
	$(RANLIB) $@

$(CPP_LIST_POOLS): Tests/cpp/list-pools.cpp $(CPP_LIBRARY) Sources/ZFSCPP/include/ZFS.hpp | $(CPP_BUILD_DIR)
	$(CXX) $(CXXFLAGS_LOCAL) $(SWIFTZFS_CXXFLAGS) $(CPPFLAGS_LOCAL) Tests/cpp/list-pools.cpp $(CPP_LIBRARY) -lzfs -lzfs_core -lzutil -lnvpair -pthread -lm $(SWIFTZFS_LINKER_FLAGS) -o $@

cpp-build: $(CPP_LIBRARY) $(CPP_LIST_POOLS)

$(CPP_EXAMPLE_HEADERS): $(CPP_PUBLIC_HEADERS) | $(CPP_BUILD_DIR)
	$(INSTALL) -d $(CPP_BUILD_DIR)/include/swiftzfs
	$(INSTALL) -m 644 $(CPP_PUBLIC_HEADERS) $(CPP_BUILD_DIR)/include/swiftzfs/
	touch $@

$(CPP_BUILD_DIR)/examples:
	mkdir -p $@

$(CPP_BUILD_DIR)/examples/%: examples/C++/%.cpp $(CPP_LIBRARY) $(CPP_EXAMPLE_HEADERS) | $(CPP_BUILD_DIR)/examples
	$(CXX) $(CXXFLAGS_LOCAL) -I$(CPP_BUILD_DIR)/include $< $(CPP_LIBRARY) -lzfs -lzfs_core -lzutil -lnvpair -pthread -lm $(SWIFTZFS_LINKER_FLAGS) -o $@

cpp-examples: $(CPP_EXAMPLE_BINS)

cpp-install: $(CPP_LIBRARY) swiftzfs-cpp.pc
	$(INSTALL) -d $(DESTDIR)$(includedir)/swiftzfs $(DESTDIR)$(libdir) $(DESTDIR)$(libdir)/pkgconfig
	$(INSTALL) -m 644 Sources/ZFSCPP/include/*.hpp $(DESTDIR)$(includedir)/swiftzfs/
	$(INSTALL) -m 644 $(CPP_LIBRARY) $(DESTDIR)$(libdir)/
	$(INSTALL) -m 644 swiftzfs-cpp.pc $(DESTDIR)$(libdir)/pkgconfig/

cpp-test: $(CPP_LIST_POOLS)
	$(CPP_LIST_POOLS) >/dev/null

cpp-run: $(CPP_LIST_POOLS)
	$(CPP_LIST_POOLS)

$(C_SHIM_OBJ): Sources/CZFS/SwiftZFS.cpp Sources/CZFS/include/SwiftZFS.h Sources/ZFSCPP/include/ZFS.hpp | $(CPP_BUILD_DIR)
	$(CXX) $(CXXFLAGS_LOCAL) $(C_SHIM_CPPFLAGS) -c Sources/CZFS/SwiftZFS.cpp -o $@

$(C_SHIM_TEST_OBJ): Tests/c/c-shim.c Sources/CZFS/include/SwiftZFS.h | $(CPP_BUILD_DIR)
	$(CC) -std=c11 -Wall -Wextra -Werror -ISources/CZFS/include -c Tests/c/c-shim.c -o $@

$(C_SHIM_TEST): $(C_SHIM_TEST_OBJ) $(C_SHIM_OBJ) $(CPP_LIBRARY_OBJS) | $(CPP_BUILD_DIR)
	$(CXX) $(C_SHIM_TEST_OBJ) $(C_SHIM_OBJ) $(CPP_LIBRARY_OBJS) -lzfs -lzfs_core -lzutil -lnvpair -pthread -lm $(SWIFTZFS_LINKER_FLAGS) -o $@

c-shim-build: $(C_SHIM_TEST)

c-shim-test: $(C_SHIM_TEST)
	$(C_SHIM_TEST) >/dev/null

c-shim-run: $(C_SHIM_TEST)
	$(C_SHIM_TEST)

docs:
	@command -v $(DOXYGEN) >/dev/null 2>&1 || { \
		echo "error: doxygen not found; install Doxygen or set DOXYGEN=/path/to/doxygen" >&2; \
		exit 1; \
	}
	$(DOXYGEN) Doxyfile

# Existing Swift layer retained for later work, but it is no longer the
# default while the C++ API is being designed.
build debug:
	$(SWIFT_ENV) $(SWIFT) build

swift-examples:
	$(SWIFT_ENV) $(SWIFT) build --package-path examples/Swift

release:
	$(SWIFT_ENV) $(SWIFT) build -c release

test:
	$(SWIFT_ENV) $(SWIFT) test

run:
	$(SWIFT_ENV) $(SWIFT) run zfs-example

clean:
	rm -rf $(CPP_BUILD_DIR)
	$(SWIFT) package clean
